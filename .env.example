# Existing PostgreSQL database URL. Keep the real value only in .env or Fly secrets.
DATABASE_URL=postgresql://username:password@host:5432/donation_ledger
DATABASE_SSL=true
ADMIN_SIGNUP_CODE=2664
CURRENCY_CODE=USD

# Google OAuth is optional. The UI enables the Google button only when both are set.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Only set during Vite development; omit in Fly production to use the same app domain.
FRONTEND_URL=http://localhost:5173
